# Supabase configuration (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# TanStack Start server configuration (server-side only; never prefix with VITE_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
# Required in production and must be an HTTPS origin. Local HTTP loopback is allowed for development.
APP_BASE_URL=http://localhost:8080

# Optional. Used only by the server to send Supabase Auth invitation emails.
# Never expose this key to browser code or commit its real value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Standalone Express API backend URL.
# If unset/empty, the app will fallback to the built-in TanStack Start server routes.
VITE_API_URL=
